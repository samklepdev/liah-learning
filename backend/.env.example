# Copy to .env and adjust. .env is gitignored.
NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (host port 54330 to avoid a clash with other projects)
DATABASE_URL=postgresql://liah:liah_dev_password@127.0.0.1:54330/liah_learning

# Only used when the frontend is served from a different origin than the API.
# In dev the Vite proxy makes them same-origin, so this can stay unset.
CORS_ORIGIN=

# How long a login lasts.
SESSION_TTL_DAYS=7

# Serve frontend/dist from this server with an SPA fallback. Required in
# production: BrowserRouter means a direct hit on /courses/x/results/y must
# return index.html rather than 404. Leave false in dev — Vite serves the app.
SERVE_FRONTEND=false
